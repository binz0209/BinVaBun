# ==========================================================
# BinVaBun Discord Companion Bot - Environment Configuration
# ==========================================================

# Discord Bot Credentials
# Get token and Guild ID from Discord Developer Portal
Discord__Token=YOUR_DISCORD_BOT_TOKEN
Discord__GuildId=YOUR_PRIVATE_GUILD_ID
Discord__DefaultChannelId=YOUR_DEFAULT_CHANNEL_ID

# MemoriesApp.Api Service Connection
Api__BaseUrl=https://your-memories-api.onrender.com
Api__BotKey=YOUR_SECRET_BOT_API_KEY
Api__TimeoutSeconds=60

# The Two Authorized Owners (Discord ID + MemoriesApp Username)
Owners__0__DiscordId=111111111111111111
Owners__0__Username=Hlinh
Owners__0__Name=Hlinh

Owners__1__DiscordId=222222222222222222
Owners__1__Username=Pthao
Owners__1__Name=Pthao

# Companion Scheduling Options
Companion__TimeZone=Asia/Ho_Chi_Minh
Companion__DailyMemoryTime=20:00
Companion__DailyQuestionTime=09:00
Companion__AnniversaryTime=08:00
Companion__AnniversaryReminderDays=7,3,1,0
Companion__CatchUpWindowHours=6
Companion__TickSeconds=30

# Logging
LOG_FORMAT=simple
